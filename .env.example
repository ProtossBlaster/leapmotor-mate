LEAPMOTOR_USER=your@email.com
LEAPMOTOR_PASS=yourpassword
LEAPMOTOR_PIN=0000
DB_PATH=leapmotor_mate.db

# Network bind. Defaults to 127.0.0.1 (loopback) for a bare `python main.py` run;
# the container sets 0.0.0.0 and Docker/ingress controls exposure.
# WEB_HOST=127.0.0.1

# ── OIDC login (standalone only; ignored when running as a Home Assistant add-on) ──
# Set all three of ISSUER/CLIENT_ID/CLIENT_SECRET to require login. Only the
# identities in OIDC_ALLOWED_USERS (email / username / sub, comma-separated) may
# sign in — everyone else is rejected. Strongly recommended before exposing Mate
# beyond localhost, since the UI can unlock and drive the car.
# OIDC_ISSUER=https://id.example.com/realms/main
# OIDC_CLIENT_ID=leapmotor-mate
# OIDC_CLIENT_SECRET=change-me
# OIDC_ALLOWED_USERS=you@example.com,partner@example.com
# OIDC_SESSION_SECRET=generate-a-long-random-string   # else sessions reset on restart
# OIDC_SCOPES=openid email profile
# OIDC_REDIRECT_URI=https://mate.example.com/auth/callback   # set behind a reverse proxy
# OIDC_COOKIE_SECURE=true                                    # set when served over HTTPS
